// MoneyOS Phase 9 — Postgres schema (Neon-compatible).
// Plaid access tokens must be encrypted before production; accessTokenEncrypted
// is nullable/placeholder in Phase 9.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(cuid())
  clerkUserId          String   @unique
  email                String?
  displayName          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  onboardingCompleted  Boolean  @default(false)
  appMode              String   @default("local_user")
  dataSourcePreference String?
  migrationCompletedAt DateTime?

  settings              UserSettings?
  bills                 Bill[]
  incomeSources         IncomeSource[]
  subscriptions         Subscription[]
  alerts                MoneyAlert[]
  consentRecords        ConsentRecord[]
  connectedInstitutions ConnectedInstitution[]
  plaidItems            PlaidItem[]
  accounts              Account[]
  transactions          MoneyTransaction[]
  transactionRules      TransactionRule[]
  weeklyReviews         WeeklyReview[]
}

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                String   @default("dark")
  defaultMode          String   @default("local_user")
  aiProviderPreference String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Bill {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  amount     Float?
  amountType String
  dueDate    DateTime?
  dueDay     Int?
  frequency  String
  autopay    Boolean   @default(false)
  paidFrom   String?
  status     String
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
}

model IncomeSource {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  source         String
  expectedAmount Float?
  amountType     String
  frequency      String
  reliability    String
  startDate      DateTime?
  nextDate       DateTime?
  active         Boolean   @default(true)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
}

model Subscription {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  amount       Float
  frequency    String
  category     String
  status       String
  renewalDate  DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model MoneyAlert {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String
  severity        String
  category        String
  suggestedAction String?
  reviewRequired  Boolean  @default(true)
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model ConsentRecord {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType   String
  acceptedAt    DateTime
  version       String
  textSummary   String
  dataScopes    Json
  plaidProducts Json?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
}

model ConnectedInstitution {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionName String
  plaidItemIdHash String?
  plaidItemId     String?
  status          String
  source          String
  connectedAt     DateTime
  lastSyncAt      DateTime?
  disconnectedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([userId, plaidItemIdHash])
}

model PlaidItem {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId        String?
  institutionName      String?
  itemIdHash           String?
  /// AES-256-GCM encrypted access token — never expose to client.
  accessTokenEncrypted String?
  environment          String    @default("sandbox")
  status               String    @default("connected")
  syncCursor           String?
  lastSyncAt           DateTime?
  disconnectedAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@unique([userId, itemIdHash])
}

model Account {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItemId        String?
  /// Server-side Plaid account_id for sync mapping — never sent to client.
  plaidAccountId     String?
  plaidAccountIdHash String?
  name               String
  institution        String
  type               String
  subtype            String?
  mask               String?
  currentBalance     Float?
  availableBalance   Float?
  source             String
  connectionStatus   String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@index([userId, plaidItemId])
  @@unique([userId, plaidAccountIdHash])
}

model MoneyTransaction {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItemId            String?
  /// Server-side Plaid transaction_id for sync mapping — never sent to client.
  plaidTransactionId     String?
  plaidTransactionIdHash String?
  accountId              String?
  date                   DateTime
  merchantName           String?
  description            String
  amount                 Float
  type                   String
  classification         String   @default("review")
  category               String
  subcategory            String?
  pending                Boolean  @default(false)
  source                 String
  needsReview            Boolean  @default(false)
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([userId])
  @@index([userId, plaidItemId])
  @@unique([userId, plaidTransactionIdHash])
}

model TransactionRule {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantPattern       String
  category              String
  shouldCountAsSpending Boolean  @default(true)
  confidenceSource      String   @default("user_approved")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@index([userId, merchantPattern])
}

model WeeklyReview {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStartDate     String
  createdAt         DateTime @default(now())
  status            String
  cashAvailable     Float
  billsDue7         Float
  billsDue14        Float
  billsDue30        Float
  incomeExpected14  Float
  monthlyRecurring  Float
  reviewItemCount   Int
  weeklyScore       Int
  summary           String
  whatMattersMost   Json
  obligationsSnapshot Json
  spendingSnapshot  Json
  risks             Json
  firstThreeActions Json
  bestNextAction    String
  userNotes         String?
  completedActions  Json?
  sourceMode        String
  aiProvider        String
  dataConfidence    String
  reminderDrafts    Json?

  @@index([userId])
  @@index([userId, weekStartDate])
}
