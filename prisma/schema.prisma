// MoneyOS Phase 9 — Postgres schema (Neon-compatible).
// Plaid access tokens must be encrypted before production; accessTokenEncrypted
// is nullable/placeholder in Phase 9.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  clerkUserId          String    @unique
  email                String?
  displayName          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  onboardingCompleted  Boolean   @default(false)
  appMode              String    @default("local_user")
  dataSourcePreference String?
  migrationCompletedAt DateTime?

  settings              UserSettings?
  bills                 Bill[]
  incomeSources         IncomeSource[]
  subscriptions         Subscription[]
  alerts                MoneyAlert[]
  consentRecords        ConsentRecord[]
  connectedInstitutions ConnectedInstitution[]
  plaidItems            PlaidItem[]
  accounts              Account[]
  transactions          MoneyTransaction[]
  transactionRules      TransactionRule[]
  weeklyReviews         WeeklyReview[]
  plannedExpenses       PlannedExpense[]
  balanceRefreshEvents  BalanceRefreshEvent[]
  balanceSnapshots      BalanceSnapshot[]
  lastAccountDataSyncAt DateTime?
  migrationRecords      AccountMigrationRecord[]
}

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                String   @default("dark")
  defaultMode          String   @default("local_user")
  aiProviderPreference String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Bill {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  amount                Float?
  amountType            String
  dueDate               DateTime?
  dueDay                Int?
  frequency             String
  autopay               Boolean   @default(false)
  paidFrom              String?
  status                String
  notes                 String?
  lastPaidAt            DateTime?
  scheduledForDate      DateTime?
  paymentUrl            String?
  paymentMethod         String?
  paymentInstructions   String?
  payeeName             String?
  reminderDaysBeforeDue Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model IncomeSource {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  source         String
  expectedAmount Float?
  amountType     String
  frequency      String
  reliability    String
  startDate      DateTime?
  nextDate       DateTime?
  lastReceivedAt DateTime?
  active         Boolean   @default(true)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
}

model Subscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  amount        Float
  frequency     String
  category      String
  status        String
  renewalDate   DateTime?
  lastRenewedAt DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

model MoneyAlert {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String
  severity        String
  category        String
  suggestedAction String?
  reviewRequired  Boolean  @default(true)
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model ConsentRecord {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType   String
  acceptedAt    DateTime
  version       String
  textSummary   String
  dataScopes    Json
  plaidProducts Json?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
}

model ConnectedInstitution {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionName String
  plaidItemIdHash String?
  plaidItemId     String?
  status          String
  source          String
  connectedAt     DateTime
  lastSyncAt      DateTime?
  disconnectedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([userId, plaidItemIdHash])
  @@index([userId, source, institutionName])
}

model PlaidItem {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId        String?
  institutionName      String?
  itemIdHash           String?
  /// AES-256-GCM encrypted access token — never expose to client.
  accessTokenEncrypted String?
  environment          String    @default("sandbox")
  status               String    @default("connected")
  syncCursor           String?
  lastSyncAt           DateTime?
  lastBalanceRefreshAt DateTime?
  disconnectedAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([userId, itemIdHash])
  @@index([userId])
  @@index([userId, institutionId, environment])
}

model Account {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItemId        String?
  /// Server-side Plaid account_id for sync mapping — never sent to client.
  plaidAccountId     String?
  plaidAccountIdHash String?
  name               String
  institution        String
  type               String
  subtype            String?
  mask               String?
  currentBalance     Float?
  availableBalance   Float?
  source             String
  connectionStatus   String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  balanceSnapshots BalanceSnapshot[]

  @@unique([userId, plaidAccountIdHash])
  @@index([userId])
  @@index([userId, plaidItemId])
}

model MoneyTransaction {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItemId            String?
  /// Server-side Plaid transaction_id for sync mapping — never sent to client.
  plaidTransactionId     String?
  plaidTransactionIdHash String?
  accountId              String?
  date                   DateTime
  merchantName           String?
  description            String
  amount                 Float
  type                   String
  classification         String    @default("review")
  category               String
  subcategory            String?
  pending                Boolean   @default(false)
  source                 String
  needsReview            Boolean   @default(false)
  notes                  String?
  userConfirmedCategory  String?
  reviewState            String    @default("needs_review")
  classificationSource   String?
  linkedBillId           String?
  linkedSubscriptionId   String?
  plaidCategoryPrimary   String?
  plaidCategoryDetailed  String?
  isTransferInternal     Boolean   @default(false)
  isRefund               Boolean   @default(false)
  isIncomeFlag           Boolean   @default(false)
  isRecurringExcluded    Boolean   @default(false)
  recurringReviewState   String?
  reviewedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([userId, plaidTransactionIdHash])
  @@index([userId])
  @@index([userId, plaidItemId])
}

model TransactionRule {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantPattern       String
  category              String
  shouldCountAsSpending Boolean  @default(true)
  confidenceSource      String   @default("user_approved")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@index([userId, merchantPattern])
}

model WeeklyReview {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStartDate       String
  createdAt           DateTime @default(now())
  status              String
  cashAvailable       Float
  billsDue7           Float
  billsDue14          Float
  billsDue30          Float
  incomeExpected14    Float
  monthlyRecurring    Float
  reviewItemCount     Int
  weeklyScore         Int
  summary             String
  whatMattersMost     Json
  obligationsSnapshot Json
  spendingSnapshot    Json
  risks               Json
  firstThreeActions   Json
  bestNextAction      String
  userNotes           String?
  completedActions    Json?
  sourceMode          String
  aiProvider          String
  dataConfidence      String
  reminderDrafts      Json?

  @@index([userId])
  @@index([userId, weekStartDate])
}

model PlannedExpense {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  title         String?
  amount        Float?
  targetDate    DateTime?
  category      String    @default("General")
  status        String    @default("planned")
  priority      String?
  notes         String?
  fundingSource String?
  reminderDate  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

model BalanceRefreshEvent {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItemId  String?
  environment  String    @default("production")
  attemptedAt  DateTime  @default(now())
  successfulAt DateTime?
  status       String
  errorCode    String?

  @@index([userId, attemptedAt])
  @@index([userId, successfulAt])
}

model AccountMigrationRecord {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceFingerprint String
  mergedAt          DateTime @default(now())
  beforeCounts      Json
  afterCounts       Json
  resultCounts      Json
  skippedDuplicates Int      @default(0)
  createdAt         DateTime @default(now())

  @@index([userId, mergedAt])
}

/// One recorded balance per account per calendar day (UTC), written only when
/// real balances are received from Plaid. Never backfilled or interpolated.
model BalanceSnapshot {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId        String
  account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// plaid_live | plaid_sandbox — Personal Live and Sandbox never mix.
  source           String
  accountType      String
  /// YYYY-MM-DD (UTC) the balance was recorded.
  snapshotDate     String
  currentBalance   Float?
  availableBalance Float?
  capturedAt       DateTime @default(now())

  @@unique([accountId, snapshotDate])
  @@index([userId, source, snapshotDate])
}
