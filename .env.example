# MoneyOS — environment configuration (server-only secrets).
# Copy this file to .env.local and fill in values. NEVER commit real secrets.
# .env.local is git-ignored.

# --- Plaid sandbox (optional) ---
# Read ONLY on the server (API routes / src/lib/plaid). Never expose to the client.

PLAID_CLIENT_ID=
PLAID_SECRET=
# Optional explicit production secret (preferred for PLAID_ENV=production live mode)
PLAID_PRODUCTION_SECRET=
# Optional: separate sandbox secret when PLAID_ENV=production (keeps sandbox Link working)
PLAID_SANDBOX_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US

# --- Personal live Plaid (Phase 12 — private owner mode, NOT public launch) ---
# Requires PLAID_ENV=production, Clerk, DATABASE_URL, encryption key, and allowlisted email.

MONEYOS_ENABLE_LIVE_PLAID=false
MONEYOS_ALLOWED_LIVE_USER_EMAIL=

# --- AI Money Agent (optional) ---
# Default: mock deterministic responses (no API key required).
# Gemini (server-side only): set AI_PROVIDER=gemini and GEMINI_API_KEY.
# AI_MODEL defaults to gemini-2.0-flash when using Gemini.

AI_PROVIDER=mock
GEMINI_API_KEY=
AI_MODEL=

# --- Authentication (optional — Clerk) ---
# App runs in local mode when unset. Never expose CLERK_SECRET_KEY to the client.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# --- Database (optional — Neon Postgres + Prisma) ---
# App uses localStorage when unset.

DATABASE_URL=

# --- Plaid token encryption (required for persisted sandbox connections) ---
# Server-side only. Generate with: openssl rand -base64 32
# Required together with Clerk auth + DATABASE_URL to persist Plaid sandbox Items.

PLAID_TOKEN_ENCRYPTION_KEY=
