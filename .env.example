# MoneyOS — environment configuration (server-only secrets).
# Copy this file to .env.local and fill in values. NEVER commit real secrets.
# .env.local is git-ignored.

# --- Plaid sandbox (optional) ---
# Read ONLY on the server (API routes / src/lib/plaid). Never expose to the client.

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US

# --- AI Money Agent (optional) ---
# Default: mock deterministic responses (no API key required).
# Gemini (server-side only): set AI_PROVIDER=gemini and GEMINI_API_KEY.
# AI_MODEL defaults to gemini-2.0-flash when using Gemini.

AI_PROVIDER=mock
GEMINI_API_KEY=
AI_MODEL=
