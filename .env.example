# MoneyOS — Plaid sandbox configuration (server-only).
# Copy this file to .env.local and fill in values from the Plaid dashboard.
# NEVER commit real secrets. .env.local is git-ignored.
#
# These are read ONLY on the server (API routes / src/lib/plaid). The
# PLAID_SECRET must never be exposed to the client/browser.

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
